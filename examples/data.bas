10 REM === DATA / READ / RESTORE DEMONSTRATION ===
20 PRINT "--- READING NUMERIC DATA ---"
30 DATA 3.08, 5.19, 3.12, 3.98, 4.24
40 DATA 5.08, 5.55, 4.00, 3.16, 3.37
50 TOTAL = 0
60 FOR I = 1 TO 10
70   READ V
80   TOTAL = TOTAL + V
90   PRINT "VALUE"; I; "="; V
100 NEXT I
110 PRINT "TOTAL ="; TOTAL
120 PRINT
130 REM --- RESTORE AND REREAD ---
140 PRINT "--- RESTORE AND REREAD ---"
150 RESTORE
160 READ A, B, C
170 PRINT "FIRST THREE VALUES:"; A; B; C
180 PRINT
190 REM --- MIXED STRING AND NUMERIC DATA ---
200 PRINT "--- CITY DATA ---"
210 DATA "DENVER", "CO", 80211
220 DATA "SEATTLE", "WA", 98101
230 DATA "BOSTON", "MA", 2101
240 RESTORE 210
250 FOR I = 1 TO 3
260   READ CITY$, STATE$, ZIP
270   PRINT CITY$; ", "; STATE$; " "; ZIP
280 NEXT I
290 PRINT
300 REM --- RESTORE TO SPECIFIC LINE ---
310 PRINT "--- RESTORE TO LINE 220 ---"
320 RESTORE 220
330 READ C$, S$, Z
340 PRINT "RESTORED TO:"; " "; C$; ", "; S$; " "; Z
350 PRINT
360 REM --- NEGATIVE AND ZERO DATA ---
370 PRINT "--- NEGATIVE AND ZERO DATA ---"
380 DATA -10, 0, 10, -3.14, 3.14
390 RESTORE 380
400 READ N1, N2, N3, N4, N5
410 PRINT N1; N2; N3; N4; N5
420 PRINT
430 REM --- DATA USED IN COMPUTATION ---
440 PRINT "--- TEMPERATURE CONVERSIONS ---"
450 DATA 32, 72, 100, 212, -40
460 RESTORE 450
470 FOR I = 1 TO 5
480   READ F
490   C = (F - 32) * 5 / 9
500   PRINT F; "F ="; C; "C"
510 NEXT I
520 PRINT
530 PRINT "DONE!"
540 END
