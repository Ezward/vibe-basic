10 REM === SCREEN COMMANDS DEMO ===
20 REM Demonstrates CLS, LOCATE, and COLOR statements
30 REM
100 COLOR 0, 0: CLS
110 COLOR 14, 1
120 LOCATE 1, 30
130 PRINT "SCREEN DEMO";
140 COLOR 7, 0
150 LOCATE 3, 1
160 PRINT "This demonstrates CLS, LOCATE, and COLOR."
170 PRINT
200 REM --- Show all 16 foreground colors ---
210 LOCATE 5, 1
220 PRINT "FOREGROUND COLORS:"
230 FOR I = 0 TO 15
240   COLOR I, 0
250   LOCATE 6, I * 4 + 1
260   PRINT I;
270 NEXT I
280 COLOR 7, 0
290 PRINT
300 REM --- Show all 8 background colors ---
310 LOCATE 8, 1
320 PRINT "BACKGROUND COLORS:"
330 FOR I = 0 TO 7
340   COLOR 15, I
350   LOCATE 9, I * 8 + 1
360   PRINT " BG"; I; " ";
370 NEXT I
380 COLOR 7, 0
390 PRINT
400 REM --- Draw a simple box ---
410 LOCATE 11, 1
420 PRINT "POSITIONED TEXT BOX:"
430 COLOR 10, 0
440 FOR R = 12 TO 16
450   LOCATE R, 5
460   IF R = 12 THEN PRINT "+----------+"
470   IF R > 12 THEN IF R < 16 THEN PRINT "|          |"
480   IF R = 16 THEN PRINT "+----------+"
490 NEXT R
500 COLOR 14, 0
510 LOCATE 14, 8
520 PRINT "HELLO"
530 COLOR 7, 0
540 LOCATE 18, 1
550 PRINT "DEMO COMPLETE."
560 END
