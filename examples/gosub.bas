10 REM === GOSUB / RETURN DEMONSTRATION ===
20 PRINT "--- BASIC GOSUB CALL ---"
30 GOSUB 2000
40 PRINT "BACK FROM SUBROUTINE"
50 PRINT
60 REM --- MULTIPLE CALLS TO SAME SUBROUTINE ---
70 PRINT "--- MULTIPLE CALLS ---"
80 FOR I = 1 TO 3
90   GOSUB 2100
100 NEXT I
110 PRINT
120 REM --- PASSING DATA VIA VARIABLES ---
130 PRINT "--- FACTORIAL VIA GOSUB ---"
140 N = 1 : GOSUB 2200 : PRINT N; "! ="; RESULT
150 N = 5 : GOSUB 2200 : PRINT N; "! ="; RESULT
160 N = 8 : GOSUB 2200 : PRINT N; "! ="; RESULT
170 N = 10 : GOSUB 2200 : PRINT N; "! ="; RESULT
180 PRINT
190 REM --- NESTED GOSUB CALLS ---
200 PRINT "--- NESTED SUBROUTINES ---"
210 GOSUB 2300
220 PRINT
230 REM --- GOSUB WITH EXPRESSION TARGET ---
240 PRINT "--- EXPRESSION TARGET ---"
250 BASE = 2000
260 GOSUB BASE
270 PRINT "CALLED SUBROUTINE AT LINE"; BASE
280 PRINT
290 REM --- GOSUB IN A LOOP WITH ACCUMULATOR ---
300 PRINT "--- SUM OF SQUARES 1..5 ---"
310 SUM = 0
320 FOR I = 1 TO 5
330   X = I
340   GOSUB 2400
350   SUM = SUM + SQUARED
360 NEXT I
370 PRINT "SUM OF SQUARES ="; SUM
380 PRINT
390 REM --- MULTI-STATEMENT LINE WITH GOSUB ---
400 PRINT "--- MULTI-STATEMENT GOSUB ---"
410 A$ = "BEFORE" : GOSUB 2500 : PRINT "AFTER GOSUB: A$ ="; " "; A$
420 PRINT
430 REM --- RETURN WITH LINE NUMBER ---
440 PRINT "--- RETURN WITH LINE NUMBER ---"
450 GOSUB 2600
460 PRINT "THIS SHOULD NOT PRINT"
470 GOTO 490
480 PRINT "REDIRECTED HERE BY RETURN 480"
490 PRINT
500 REM --- RETURN WITH EXPRESSION TARGET ---
510 PRINT "--- RETURN WITH EXPRESSION ---"
520 TARGET = 560
530 GOSUB 2700
540 PRINT "THIS SHOULD NOT PRINT EITHER"
550 GOTO 570
560 PRINT "REDIRECTED BY RETURN WITH EXPRESSION"
570 PRINT
580 PRINT "ALL TESTS PASSED!"
590 END
2000 REM --- SIMPLE GREETING SUBROUTINE ---
2010 PRINT "HELLO FROM SUBROUTINE!"
2020 RETURN
2100 REM --- PRINT COUNTER SUBROUTINE ---
2110 PRINT "CALL NUMBER"; I
2120 RETURN
2200 REM --- FACTORIAL SUBROUTINE ---
2210 REM COMPUTES RESULT = N!
2220 RESULT = 1
2230 FOR J = 2 TO N
2240   RESULT = RESULT * J
2250 NEXT J
2260 RETURN
2300 REM --- OUTER NESTED SUBROUTINE ---
2310 PRINT "ENTERING OUTER"
2320 GOSUB 2350
2330 PRINT "LEAVING OUTER"
2340 RETURN
2350 REM --- INNER NESTED SUBROUTINE ---
2360 PRINT "  ENTERING INNER"
2370 PRINT "  LEAVING INNER"
2380 RETURN
2400 REM --- SQUARE SUBROUTINE ---
2410 SQUARED = X * X
2420 RETURN
2500 REM --- MODIFY VARIABLE SUBROUTINE ---
2510 A$ = "MODIFIED"
2520 RETURN
2600 REM --- RETURN WITH LINE NUMBER SUBROUTINE ---
2610 PRINT "IN RETURN-LINE-NUMBER SUB"
2620 RETURN 480
2700 REM --- RETURN WITH EXPRESSION TARGET SUBROUTINE ---
2710 PRINT "IN RETURN-EXPRESSION SUB"
2720 RETURN TARGET
