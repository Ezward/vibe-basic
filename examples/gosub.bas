10 REM === GOSUB / RETURN DEMONSTRATION ===
20 PRINT "--- BASIC GOSUB CALL ---"
30 GOSUB 500
40 PRINT "BACK FROM SUBROUTINE"
50 PRINT
60 REM --- MULTIPLE CALLS TO SAME SUBROUTINE ---
70 PRINT "--- MULTIPLE CALLS ---"
80 FOR I = 1 TO 3
90   GOSUB 600
100 NEXT I
110 PRINT
120 REM --- PASSING DATA VIA VARIABLES ---
130 PRINT "--- FACTORIAL VIA GOSUB ---"
140 N = 1 : GOSUB 700 : PRINT N; "! ="; RESULT
150 N = 5 : GOSUB 700 : PRINT N; "! ="; RESULT
160 N = 8 : GOSUB 700 : PRINT N; "! ="; RESULT
170 N = 10 : GOSUB 700 : PRINT N; "! ="; RESULT
180 PRINT
190 REM --- NESTED GOSUB CALLS ---
200 PRINT "--- NESTED SUBROUTINES ---"
210 GOSUB 800
220 PRINT
230 REM --- GOSUB WITH EXPRESSION TARGET ---
240 PRINT "--- EXPRESSION TARGET ---"
250 BASE = 500
260 GOSUB BASE
270 PRINT "CALLED SUBROUTINE AT LINE"; BASE
280 PRINT
290 REM --- GOSUB IN A LOOP WITH ACCUMULATOR ---
300 PRINT "--- SUM OF SQUARES 1..5 ---"
310 SUM = 0
320 FOR I = 1 TO 5
330   X = I
340   GOSUB 900
350   SUM = SUM + SQUARED
360 NEXT I
370 PRINT "SUM OF SQUARES ="; SUM
380 PRINT
390 REM --- MULTI-STATEMENT LINE WITH GOSUB ---
400 PRINT "--- MULTI-STATEMENT GOSUB ---"
410 A$ = "BEFORE" : GOSUB 950 : PRINT "AFTER GOSUB: A$ ="; " "; A$
420 PRINT
430 PRINT "ALL TESTS PASSED!"
440 END
500 REM --- SIMPLE GREETING SUBROUTINE ---
510 PRINT "HELLO FROM SUBROUTINE!"
520 RETURN
600 REM --- PRINT COUNTER SUBROUTINE ---
610 PRINT "CALL NUMBER"; I
620 RETURN
700 REM --- FACTORIAL SUBROUTINE ---
710 REM COMPUTES RESULT = N!
720 RESULT = 1
730 FOR J = 2 TO N
740   RESULT = RESULT * J
750 NEXT J
760 RETURN
800 REM --- OUTER NESTED SUBROUTINE ---
810 PRINT "ENTERING OUTER"
820 GOSUB 850
830 PRINT "LEAVING OUTER"
840 RETURN
850 REM --- INNER NESTED SUBROUTINE ---
860 PRINT "  ENTERING INNER"
870 PRINT "  LEAVING INNER"
880 RETURN
900 REM --- SQUARE SUBROUTINE ---
910 SQUARED = X * X
920 RETURN
950 REM --- MODIFY VARIABLE SUBROUTINE ---
960 A$ = "MODIFIED"
970 RETURN
