10 REM === ARRAY DEMONSTRATION PROGRAM ===
20 PRINT "=== BASIC ARRAY TESTS ==="
30 PRINT
100 REM --- Test 1: Simple 1D array with DIM ---
110 PRINT "TEST 1: 1D ARRAY"
120 DIM A(5)
130 FOR I = 0 TO 5
140   A(I) = I * 10
150 NEXT I
160 FOR I = 0 TO 5
170   PRINT "A("; I; ") ="; A(I)
180 NEXT I
190 PRINT
200 REM --- Test 2: Multi-dimensional array ---
210 PRINT "TEST 2: 2D ARRAY (3x4 MATRIX)"
220 DIM M(2, 3)
230 FOR R = 0 TO 2
240   FOR C = 0 TO 3
250     M(R, C) = R * 10 + C
260   NEXT C
270 NEXT R
280 FOR R = 0 TO 2
290   FOR C = 0 TO 3
300     PRINT M(R, C);
310   NEXT C
320   PRINT
330 NEXT R
340 PRINT
400 REM --- Test 3: String array ---
410 PRINT "TEST 3: STRING ARRAY"
420 DIM N$(4)
430 N$(0) = "ALICE"
440 N$(1) = "BOB"
450 N$(2) = "CHARLIE"
460 N$(3) = "DIANA"
470 N$(4) = "EVE"
480 FOR I = 0 TO 4
490   PRINT N$(I); " ";
500 NEXT I
510 PRINT
520 PRINT
600 REM --- Test 4: ERASE and re-DIM ---
610 PRINT "TEST 4: ERASE AND REDIMENSION"
620 PRINT "A(3) BEFORE ERASE:"; A(3)
630 ERASE A
640 DIM A(10)
650 PRINT "A(3) AFTER ERASE AND REDIM:"; A(3)
660 A(7) = 777
670 PRINT "A(7) ="; A(7)
680 PRINT
700 REM --- Test 5: Auto-dimensioned array (no DIM) ---
710 PRINT "TEST 5: AUTO-DIMENSIONED ARRAY"
720 B(5) = 55
730 B(10) = 100
740 PRINT "B(5) ="; B(5)
750 PRINT "B(10) ="; B(10)
760 PRINT "B(0) ="; B(0)
770 PRINT
800 REM --- Test 6: Array with computed indices ---
810 PRINT "TEST 6: COMPUTED INDICES"
820 DIM C(20)
830 FOR I = 1 TO 5
840   C(I * 2) = I ^ 2
850 NEXT I
860 FOR I = 1 TO 5
870   PRINT "C("; I * 2; ") ="; C(I * 2)
880 NEXT I
890 PRINT
900 REM --- Test 7: READ DATA into array ---
910 PRINT "TEST 7: READ DATA INTO ARRAY"
920 DIM D(4)
930 DATA 10, 20, 30, 40, 50
940 FOR I = 0 TO 4
950   READ D(I)
960 NEXT I
970 FOR I = 0 TO 4
980   PRINT "D("; I; ") ="; D(I)
990 NEXT I
995 PRINT
1000 REM --- Test 8: 3D array ---
1010 PRINT "TEST 8: 3D ARRAY"
1020 DIM V(1, 1, 1)
1030 V(0, 0, 0) = 1
1040 V(1, 1, 1) = 8
1050 V(0, 1, 0) = 3
1060 PRINT "V(0,0,0) ="; V(0, 0, 0)
1070 PRINT "V(1,1,1) ="; V(1, 1, 1)
1080 PRINT "V(0,1,0) ="; V(0, 1, 0)
1090 PRINT
1100 REM --- Test 9: Array element arithmetic ---
1110 PRINT "TEST 9: ARRAY ELEMENT ARITHMETIC"
1120 DIM X(3)
1130 X(1) = 10
1140 X(2) = 20
1150 X(3) = X(1) + X(2)
1160 PRINT "X(1) + X(2) = X(3) ="; X(3)
1170 PRINT "X(1) * X(2) ="; X(1) * X(2)
1180 PRINT
1200 REM --- Test 10: Multiple DIM on one statement ---
1210 PRINT "TEST 10: MULTIPLE ARRAYS IN ONE DIM"
1220 DIM P(3), Q(2, 2)
1230 P(1) = 111
1240 Q(1, 1) = 222
1250 PRINT "P(1) ="; P(1)
1260 PRINT "Q(1,1) ="; Q(1, 1)
1270 PRINT
1300 PRINT "=== ALL ARRAY TESTS COMPLETE ==="
1310 END
